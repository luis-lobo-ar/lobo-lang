{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Lobo Core conformance corpus v0.1",
  "type": "object",
  "additionalProperties": false,
  "required": ["format", "language", "cases"],
  "properties": {
    "format": { "const": "lobo-conformance/0.1" },
    "language": { "const": "core/0.1-draft" },
    "cases": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "rule", "source", "expected"],
        "properties": {
          "id": { "type": "string", "minLength": 1 },
          "rule": { "type": "string", "minLength": 1 },
          "source": { "type": "string", "minLength": 1 },
          "invocation": {
            "type": "object",
            "additionalProperties": false,
            "required": ["entry", "arguments"],
            "properties": {
              "entry": { "type": "string", "minLength": 1 },
              "arguments": { "type": "array", "items": { "$ref": "#/$defs/value" } }
            }
          },
          "expected": {
            "oneOf": [
              {
                "type": "object", "additionalProperties": false,
                "required": ["kind", "value"],
                "properties": { "kind": { "const": "value" }, "value": { "$ref": "#/$defs/value" } }
              },
              {
                "type": "object", "additionalProperties": false,
                "required": ["kind", "code"],
                "properties": {
                  "kind": { "enum": ["compile_error", "runtime_fault"] },
                  "code": { "type": "string", "minLength": 1 }
                }
              }
            ]
          }
        }
      }
    }
  },
  "$defs": {
    "value": {
      "oneOf": [
        {
          "type": "object", "additionalProperties": false,
          "required": ["type", "value"],
          "properties": { "type": { "const": "I64" }, "value": { "type": "string", "pattern": "^(0|[1-9][0-9]*|-[1-9][0-9]*)$" } }
        },
        {
          "type": "object", "additionalProperties": false,
          "required": ["type", "value"],
          "properties": { "type": { "const": "Bool" }, "value": { "type": "boolean" } }
        }
      ]
    }
  }
}
