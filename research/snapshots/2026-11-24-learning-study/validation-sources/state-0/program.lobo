module questions;
record Cursor { pending: List<I64>, total: I64 }
record State { index: I64, total: I64 }
fn p0()->I64 {fold(i in 5, total:I64=4) { total+i+1 }}
fn p1()->I64 {fold(i in 0, total:I64=4) { 1/0 }}
fn p2()->I64 {let final=while(state:State=State {index:0,total:4};state.index<5) { State {index:state.index+1,total:state.total+state.index} }; final.total}
fn p3()->I64 {List::head(List::prepend(5,List::prepend(4,List::empty<I64>())))}
fn p4()->I64 {List::head(List::tail(List::prepend(4,List::prepend(5,List::empty<I64>()))))}
fn p5()->I64 {let final=fold(i in 3,cursor:Cursor=Cursor {pending:List::prepend(5,List::prepend(4,List::prepend(2,List::empty<I64>()))),total:0}) {Cursor {pending:List::tail(cursor.pending),total:10*cursor.total+List::head(cursor.pending)}}; final.total}
