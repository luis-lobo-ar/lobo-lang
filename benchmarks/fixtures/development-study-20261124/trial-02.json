  "final_sources": {
    "util.lobo": "module util;\nrecord Reverse<T> {pending:List<T>,output:List<T>}\nfn reverse<T>(items:List<T>)->List<T> {\n let final=fold(i in List::length(items),state:Reverse<T>=Reverse {pending:items,output:List::empty<T>()}) {\n  Reverse {pending:List::tail(state.pending),output:List::prepend(List::head(state.pending),state.output)}\n };final.output\n}\n",
    "logic.lobo.ids.json": "{\n  \"format\": \"lobo-identities/0.1\",\n  \"identities\": {\n    \"module\": \"skilldev.batch.module\",\n    \"convert\": \"skilldev.batch.convert\",\n    \"run\": \"skilldev.batch.run\",\n    \"model.Sample\": \"skilldev.batch.model.Sample\",\n    \"model.Summary\": \"skilldev.batch.model.Summary\",\n    \"model.Outcome\": \"skilldev.batch.model.Outcome\",\n    \"util.reverse\": \"skilldev.util.reverse\"\n  }\n}\n",
    "util.lobo.ids.json": "{\n  \"format\": \"lobo-identities/0.1\",\n  \"identities\": {\n    \"module\": \"skilldev.util.module\",\n    \"Reverse\": \"skilldev.util.Reverse\",\n    \"reverse\": \"skilldev.util.reverse\"\n  }\n}\n",
    "logic.lobo": "module logic;\nuse model {Sample,Summary,Outcome};\nuse util {reverse};\nrecord RunState {pending:List<Sample>,values:List<I64>,total:I64,maximum:I64,failed:Bool,error:I64}\nfn max_value(left:I64,right:I64)->I64 {\n let choice=if left > right {left} else {right};choice\n}\nfn convert(sample:Sample)->Outcome<I64> {\n let choice=if sample.raw < 0 {Err(11)} else if sample.scale <= 0 {Err(12)} else {Ok(sample.raw*sample.scale)};choice\n}\nfn run(samples:List<Sample>)->Outcome<Summary> {\n let final=while(state:RunState=RunState {pending:samples,values:List::empty<I64>(),total:0,maximum:0,failed:false,error:0}; List::length(state.pending) > 0 && !state.failed) {\n  match convert(List::head(state.pending)) {\n   Ok(value)=>RunState {pending:List::tail(state.pending),values:List::prepend(value,state.values),total:state.total+value,maximum:max_value(state.maximum,value),failed:false,error:state.error},\n   Err(code)=>RunState {pending:List::tail(state.pending),values:state.values,total:state.total,maximum:state.maximum,failed:true,error:code}\n  }\n };if final.failed {Err(final.error)} else {Ok(Summary {values:reverse(final.values),total:final.total,maximum:final.maximum})}\n}\n",
    "model.lobo": "module model;\nrecord Sample {raw:I64,scale:I64}\nrecord Summary {values:List<I64>,total:I64,maximum:I64}\nvariant Outcome<T> {Ok(T),Err(I64)}\n",
    "model.lobo.ids.json": "{\n  \"format\": \"lobo-identities/0.1\",\n  \"identities\": {\n    \"module\": \"skilldev.batch.model.module\",\n    \"Sample\": \"skilldev.batch.model.Sample\",\n    \"Summary\": \"skilldev.batch.model.Summary\",\n    \"Outcome\": \"skilldev.batch.model.Outcome\"\n  }\n}\n"
  },
