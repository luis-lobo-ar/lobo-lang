module comparison @id("comparison");
record State @id("comparison.state") { kind: I64, amount: I64 }
function valid @id("comparison.valid")(amount: I64) -> Bool {
  amount >= 0 && amount <= 100
}
function decode @id("comparison.decode")(kind: I64, amount: I64) -> State {
  if kind == 0 { State { kind: 0, amount: amount } } else {
    if kind == 1 { State { kind: 1, amount: amount } } else {
      if kind == 2 { State { kind: 2, amount: amount } } else { State { kind: -1, amount: 0 } }
    }
  }
}
function step @id("comparison.step")(state: State, action: I64) -> State {
  if state.kind == 0 && action == 0 { State { kind: 1, amount: state.amount } } else {
    if state.kind == 1 && action == 1 { State { kind: 2, amount: state.amount } } else {
      if state.kind == 2 && action == 2 { State { kind: 0, amount: state.amount } } else {
        State { kind: -1, amount: 0 }
      }
    }
  }
}
function code @id("comparison.code")(state: State) -> I64 {
  if state.kind == 0 { state.amount } else {
    if state.kind == 1 { 1000 + state.amount } else {
      if state.kind == 2 { 2000 + state.amount } else { -900 }
    }
  }
}
function run @id("comparison.run")(kind: I64, amount: I64, action: I64) -> I64 {
  if !valid(amount) { -100 } else { code(step(decode(kind, amount), action)) }
}
