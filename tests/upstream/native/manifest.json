    },
    {
      "source": "libuv/test/test-tcp-close.c",
      "tests": [
        "tests/native_adapter.rs"
      ],
      "adaptation": "Close/reuse and pending-resource cleanup invariants; asynchronous callback ordering is not claimed."
    },
    {
      "source": "libuv/test/test-tcp-shutdown-after-write.c",
      "tests": [
        "tests/native_tcp.rs",
        "tests/native_adapter.rs"
      ],
      "adaptation": "Drain bytes written before observing write-side shutdown EOF."
    },
    {
      "source": "go/src/net/timeout_test.go",
      "tests": [
        "tests/native_adapter.rs",
        "tests/native_tcp.rs"
      ],
      "adaptation": "Absolute deadlines must survive interruption/spurious readiness. Negative or over-2000ms timeout inputs are invalid in Lobo v1."
    },
    {
      "source": "rust/library/std/src/net/tcp/tests.rs",
      "tests": [
        "tests/native_tcp.rs",
        "tests/native_adapter.rs"
      ],
      "adaptation": "IPv4 loopback connection, binary roundtrip, bind failure, shutdown and EOF. Other address families are not claimed."
    },
    {
      "source": "nodejs/test/node-api/test_buffer/test.js",
      "tests": [
        "tests/native_adapter.rs"
      ],
      "adaptation": "Independent returned byte storage; explicit borrowed input and owned invocation buffer lifetimes."
    }
