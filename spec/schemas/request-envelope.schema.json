{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://lobo-lang.invalid/spec/ltp/0.1/request-envelope.schema.json",
  "title": "Lobo Tool Protocol request envelope",
  "type": "object",
  "additionalProperties": false,
  "required": ["ltp", "request_id", "session_id", "tool", "target", "arguments"],
  "properties": {
    "ltp": {
      "const": "0.1"
    },
    "request_id": {
      "$ref": "#/$defs/identifier"
    },
    "session_id": {
      "$ref": "#/$defs/identifier"
    },
    "tool": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9_]*(\\.[a-z][a-z0-9_]*)+$",
      "maxLength": 128
    },
    "target": {
      "type": "object",
      "additionalProperties": false,
      "required": ["workspace"],
      "properties": {
        "workspace": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128
        },
        "revision": {
          "type": "string",
          "minLength": 1,
          "maxLength": 256
        },
        "transaction": {
          "$ref": "#/$defs/identifier"
        }
      },
      "allOf": [
        {
          "not": {
            "required": ["revision", "transaction"]
          }
        }
      ]
    },
    "idempotency_key": {
      "type": "string",
      "minLength": 1,
      "maxLength": 256
    },
    "budget": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "wall_time_ms": {
          "type": "integer",
          "minimum": 1,
          "maximum": 3600000
        },
        "output_bytes": {
          "type": "integer",
          "minimum": 1,
          "maximum": 16777216
        },
        "operations": {
          "type": "integer",
          "minimum": 1,
          "maximum": 100000
        }
      }
    },
    "arguments": {
      "type": "object"
    }
  },
  "$defs": {
    "identifier": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$"
    }
  }
}

