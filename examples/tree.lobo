module tree;

use deps { reverse_shared };

// Children are the nodes with this parent's index and a lesser/greater key.
// Index -1 means no parent; every I64 remains available as a key.
record Node { index: I64, parent: I64, key: I64, depth: I64 }
variant OptionalNode { Found(Node), Empty }
record Tree { nodes: List<Node>, root: OptionalNode, height: I64 }
record Lookup { remaining: List<Node>, found: OptionalNode }
record Search {
  current: OptionalNode, parent: I64, depth: I64, duplicate: Bool
}
record Build { remaining: List<I64>, tree: Tree }
record Walk { current: OptionalNode, pending: List<Node>, keys: List<I64> }
record Summary { keys: List<I64>, count: I64, height: I64 }

fn child(nodes: List<Node>, parent: Node, left: Bool) -> OptionalNode {
  let done = fold(i in List::length(nodes), state: Lookup = Lookup { remaining: nodes, found: Empty }) {
    let node = List::head(state.remaining);
    Lookup {
      remaining: List::tail(state.remaining),
      found: if node.parent == parent.index && node.key < parent.key == left {
        Found(node)
      } else { state.found }
    }
  };
  done.found
}

fn insert(tree: Tree, key: I64) -> Tree {
  let position = while(state: Search = Search {
    current: tree.root, parent: -1, depth: 1, duplicate: false
    }; !state.duplicate && match(state.current) { Empty => false, Found(node) => true }) {
    if state.duplicate { state } else {
      match (state.current) {
        Empty => state,
        Found(node) => if key == node.key {
          Search { current: state.current, parent: state.parent, depth: state.depth, duplicate: true }
        } else {
          Search {
            current: child(tree.nodes, node, key < node.key), parent: node.index,
            depth: node.depth + 1, duplicate: false
          }
        }
      }
    }
  };
  if position.duplicate { tree } else {
    let node = Node { index: List::length(tree.nodes), parent: position.parent, key: key, depth: position.depth };
    let root = match (tree.root) { Empty => OptionalNode::Found(node), Found(existing) => OptionalNode::Found(existing) };
    Tree {
      nodes: List::prepend(node, tree.nodes), root: root,
      height: if position.depth > tree.height { position.depth } else { tree.height }
    }
  }
}

fn build(input: List<I64>) -> Tree {
  let done = fold(i in List::length(input), state: Build = Build {
    remaining: input, tree: Tree { nodes: List::empty<Node>(), root: Empty, height: 0 }
  }) {
    Build { remaining: List::tail(state.remaining), tree: insert(state.tree, List::head(state.remaining)) }
  };
  done.tree
}

fn reverse(input: List<I64>) -> List<I64>
ensures { List::length(result) == List::length(input) }
{
  reverse_shared(input)
}

fn traverse(tree: Tree, descending: Bool) -> List<I64> {
  let done = fold(i in 2 * List::length(tree.nodes), state: Walk = Walk {
    current: tree.root, pending: List::empty<Node>(), keys: List::empty<I64>()
  }) {
    match (state.current) {
      Found(node) => Walk {
        current: child(tree.nodes, node, !descending), pending: List::prepend(node, state.pending), keys: state.keys
      }
      ,
      Empty => if List::length(state.pending) == 0 { state } else {
        let node = List::head(state.pending);
        Walk {
          current: child(tree.nodes, node, descending), pending: List::tail(state.pending),
          keys: List::prepend(node.key, state.keys)
        }
      }
    }
  };
  reverse(done.keys)
}

fn summarize(input: List<I64>, descending: Bool) -> Summary
ensures { result.count == List::length(result.keys) }
{
  let tree = build(input);
  Summary { keys: traverse(tree, descending), count: List::length(tree.nodes), height: tree.height }
}

identities {
  module: "example.tree",
  deps.reverse_shared: "example.collections.reverse",
  Node: "example.tree.node",
  OptionalNode: "example.tree.optional_node",
  Tree: "example.tree.tree",
  Lookup: "example.tree.lookup",
  Search: "example.tree.search",
  Build: "example.tree.build",
  Walk: "example.tree.walk",
  Summary: "example.tree.summary",
  child: "example.tree.child",
  insert: "example.tree.insert",
  build: "example.tree.build_tree",
  reverse: "example.tree.reverse",
  traverse: "example.tree.traverse",
  summarize: "example.tree.summarize"
}
