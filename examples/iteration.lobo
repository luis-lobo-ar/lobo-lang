module iteration;

fn sum(n: I64) -> I64
requires { n >= 0 }
ensures { result >= 0 }
{
  fold (i in n, total: I64 = 0) {
    total + i + 1
  }
}

fn factorial(n: I64) -> I64
requires { n >= 0 && n <= 20 }
ensures { result >= 1 }
{
  fold (i in n, product: I64 = 1) {
    product * (i + 1)
  }
}

identities {
  module: "example.iteration",
  sum: "example.sum",
  factorial: "example.factorial.iterative"
}
