module sqlite_rest;
use access {restrict};

use io { server_permissions, serve_with };
use http { Request, Response };
use controller { handle };
use model { setup_data };
use sql { error_code, Permission, one, restrict_native };

fn initialize(cap: Native::SqliteCapability, enabled: Bool) -> Native::BoolResult
actions { db.open, db.close, db.execute, db.read, db.transaction }
{
  if !enabled {
    Ok(true)
  } else {
    let db = try Native::sqlite_open(cap);
    let outcome = setup_data(db);
    try Native::sqlite_close(db);
    match outcome {
      Ok(done) => Ok(done),
      Err(error) => Err(error_code(error))
    }
  }
}

fn main(port: I64, max_requests: I64, bootstrap: Bool) -> Native::I64Result
actions { native.authorize, clock.read, net.listen, net.accept, net.read, net.write, net.close,
  db.open, db.close, db.execute, db.read, db.transaction }
requires { port >= 1 && port <= 65535 && max_requests >= 1 && max_requests <= 128 }
{
  let network_root = Native::capability();
  let database_root = Native::sqlite_capability();
  let cap = try restrict(network_root, server_permissions());
  try initialize(database_root, bootstrap);
  let read_cap = try restrict_native(database_root, one(Read));
  let db = try Native::sqlite_open(read_cap);
  let outcome = serve_with(cap, port, max_requests, db, handle);
  try Native::sqlite_close(db);
  outcome
}
