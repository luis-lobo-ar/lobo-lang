module arithmetic;

fn increment(x: I64) -> I64
requires { x < 9223372036854775807 }
ensures { result == x + 1 }
{
  let next: I64 = x + 1;
  next
}

fn absolute(x: I64) -> I64
requires { x != -9223372036854775808 }
ensures { result >= 0 }
{
  if x < 0 { -x } else { x }
}

identities {
  module: "example.arithmetic",
  increment: "example.increment",
  absolute: "example.absolute"
}
