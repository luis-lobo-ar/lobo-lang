module arithmetic @id("example.arithmetic");

function increment @id("example.increment")(x: I64) -> I64
  requires { x < 9223372036854775807 }
  ensures { result == x + 1 }
{
  let next: I64 = x + 1;
  next
}

function absolute @id("example.absolute")(x: I64) -> I64
  requires { x != -9223372036854775808 }
  ensures { result >= 0 }
{
  if x < 0 { -x } else { x }
}
