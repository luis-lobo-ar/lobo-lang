// Core v0.4: structured fold state, without assignment or a new loop construct.
module record_demo;

record Pair {
  left: I64,
  right: I64
}

fn swap(p: Pair) -> Pair
ensures { result.left == p.right && result.right == p.left }
{
  Pair { right: p.left, left: p.right }
}

fn gcd(a: I64, b: I64) -> I64
requires { a > 0 && b > 0 }
ensures { result > 0 && a % result == 0 && b % result == 0 }
{
  let p = fold(i in 100, state: Pair = Pair { left: a, right: b }) {
    if state.right == 0 {
      state
    } else {
      Pair { left: state.right, right: state.left % state.right }
    }
  };
  p.left
}

identities {
  module: "example.records",
  Pair: "example.records.pair",
  swap: "example.records.swap",
  gcd: "example.records.gcd"
}
