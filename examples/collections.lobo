module collections;

use deps { reverse };

record Work { remaining: List<I64>, kept: List<I64>, sum: I64 }
record Invalid { index: I64, value: I64 }
record Summary { values: List<I64>, count: I64, sum: I64 }
variant Step { Continue(Work), InvalidValue(Invalid) }
variant Selection { Ok(Summary), InvalidValue(Invalid) }

fn select(input: List<I64>, keep_even: Bool) -> Selection {
  let final = fold(i in List::length(input), state: Step = Continue(Work { remaining: input, kept: List::empty<I64>(), sum: 0 })) {
    match state {
      InvalidValue(error) => InvalidValue(error),
      Continue(work) => {
        let value = List::head(work.remaining);
        if value < 0 || value > 1000 { InvalidValue(Invalid { index: i, value: value }) } else {
          let keep = (value % 2 == 0) == keep_even;
          let kept = if keep { List::prepend(value, work.kept) } else { work.kept };
          let total = if keep { work.sum + value } else { work.sum };
          Continue(Work { remaining: List::tail(work.remaining), kept: kept, sum: total })
        }
      }
    }
  };
  match final {
    InvalidValue(error) => InvalidValue(error),
    Continue(work) => Ok(Summary { values: reverse(work.kept), count: List::length(work.kept), sum: work.sum })
  }
}

identities {
  module: "example.collections",
  deps.reverse: "example.collections.reverse",
  Work: "example.collections.work",
  Invalid: "example.collections.invalid",
  Summary: "example.collections.summary",
  Step: "example.collections.step",
  Selection: "example.collections.selection",
  select: "example.collections.select"
}
